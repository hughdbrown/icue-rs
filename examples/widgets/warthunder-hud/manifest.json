{
	"author": "EdgeHost",
	"id": "dev.edgehost.warthunder-hud",
	"name": "War Thunder HUD",
	"description": "Flight and vehicle telemetry, kill feed and chat from War Thunder's telemetry server (port 8111 on this Mac or on the game PC).",
	"version": "0.2.0",
	"preview_icon": "resources/icon.svg",
	"min_app_version": "5.47",
	"min_framework_version": "1.0.0",
	"os": [{ "platform": "windows" }, { "platform": "mac" }],
	"supported_devices": [{ "type": "dashboard_lcd" }],
	"interactive": true,
	"permissions": [
		{ "type": "url", "domain": "localhost", "port": 8111 },
		{ "type": "url", "domain": "any", "port": 8111 }
	]
}
